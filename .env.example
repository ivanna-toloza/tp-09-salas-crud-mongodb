# =============================================================================
# ARCHIVO: .env.example · PLANTILLA DE VARIABLES DE ENTORNO
# -----------------------------------------------------------------------------
# Se copia como .env y se completan los datos reales. Este archivo SÍ se sube
# al repositorio porque no tiene secretos; el .env real está en .gitignore.
# Formato: NOMBRE=valor, una variable por línea. Las líneas que empiezan con #
# son comentarios y Node las ignora al leer el archivo con --env-file.
# =============================================================================
# Puerto donde escucha el servidor (lo lee config/entorno.js).
PORT=3000
# Entorno: development hace que morgan use el formato "dev" (corto, con colores).
NODE_ENV=development
# URI de conexión a MongoDB Atlas. USUARIO, CLAVE y HOST son marcadores que hay
# que reemplazar; reservas_salas_u9 es el nombre de la base de este TP.
# retryWrites=true reintenta una escritura una vez si falla por un corte de red;
# w=majority espera a que la mayoría de los servidores del clúster la confirme.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@HOST/reservas_salas_u9?retryWrites=true&w=majority
